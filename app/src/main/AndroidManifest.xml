<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".RestartAPP"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/net_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Restart">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".func.chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".func.login.PhoneLoginActivity"
            android:exported="false" />
        <activity
            android:name=".func.media.CameraViewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".func.media.AlbumViewActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".func.media.ImagePreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".func.main.moment.MomentPublishActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".func.main.home.HistoryDetailActivity"
            android:exported="false" />
    </application>

</manifest>